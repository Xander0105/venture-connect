rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read/write their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Proposals are readable by all authenticated users
    match /proposals/{proposalId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == resource.data.ownerId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId;
    }
    
    // Financial products
    match /financialProducts/{productId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == resource.data.bankerId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.bankerId;
    }
  }
}
